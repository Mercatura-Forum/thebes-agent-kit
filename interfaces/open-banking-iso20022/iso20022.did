  validatePain001XmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateParticipantDirectoryEntry: (input: ParticipantDirectoryInput) ->
   (ValidationReport) query;
  validateRequestToPayWithProfile: (profileId: text, doc:
   RequestToPayMessage) -> (ValidationReport) query;
  validateRequestToPayXml: (xml: blob) -> (ValidationReport) query;
  validateRequestToPayXmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateStatusReportWithProfile: (profileId: text, doc: StatusReport,
   expectedKind: text) -> (ValidationReport) query;
  validateStatusReportXml: (xml: blob, expectedKind: opt text) ->
   (ValidationReport) query;
  validateStatusReportXmlWithProfile: (profileId: text, xml: blob,
