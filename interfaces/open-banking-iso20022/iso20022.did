  operatingDayStatus: (currency: text) -> (OperatingDayStatus) query;
  oraclePhaseRegistry: () -> (vec PhaseOracleSpec) query;
  outboundBatchCount: () -> (nat) query;
  pacs008ToXml: (doc: Pacs008CreditTransfer) -> (text) query;
  pacs009ToXml: (doc: Pacs009FinancialInstitutionCreditTransfer) ->
   (text) query;
  pain001ToXml: (doc: CustomerCreditTransferInitiation) -> (text) query;
  parseMt103Fields: (mt: text) -> (vec Mt103Field) query;
  paymentCount: () -> (nat) query;
