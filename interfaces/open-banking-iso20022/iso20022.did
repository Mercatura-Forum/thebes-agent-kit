  listOutboundBatchesByConnectorStatusStable: (connectorId: text, status:
   text, offset: nat, limit: nat) -> (Page_7) query;
  listOutboundBatchesForConnector: (connectorId: text, offset: nat, limit:
   nat) -> (Page_7) query;
  listParticipantDirectory: (offset: nat, limit: nat) -> (Page_6) query;
  listPaymentComplianceReports: (offset: nat, limit: nat) -> (Page_5) query;
  listPaymentViews: (offset: nat, limit: nat) -> (Page_4) query;
