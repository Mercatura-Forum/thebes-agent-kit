  listDeadLetters: (offset: nat, limit: nat) -> (Page_1) query;
  listEndOfDayRuns: (offset: nat, limit: nat) -> (Page_8) query;
  listGuidelineProfiles: () -> (vec GuidelineProfileSummary) query;
