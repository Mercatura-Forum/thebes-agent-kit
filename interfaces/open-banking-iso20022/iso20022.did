   vec text, allowedEndpoints: vec text) -> (ConnectorConfig);
  rejectComplianceHold: (paymentId: nat, reason: text) -> (HubPayment);
  releaseComplianceHold: (paymentId: nat, reason: text) -> (HubPayment);
