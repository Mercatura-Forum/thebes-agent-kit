  validateCamt053XmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateCamt054Xml: (xml: blob) -> (ValidationReport) query;
  validateCamt054XmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateCoverPayment: (doc: CoverPayment, rawXml: opt blob) ->
   (ValidationReport) query;
  validateCoverPaymentWithProfile: (profileId: text, doc: CoverPayment,
   rawXml: opt blob) -> (ValidationReport) query;
  validateCoverPaymentXml: (xml: blob) -> (ValidationReport) query;
  validateCoverPaymentXmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateDemoCoverPayment: () -> (ValidationReport) query;
  validateDemoCrossBorderPacs008WithProfile: (profileId: text) ->
   (ValidationReport) query;
  validateDemoCrossBorderPain001WithProfile: (profileId: text) ->
   (ValidationReport) query;
  validateDemoPacs008: () -> (ValidationReport) query;
  validateDemoPacs008WithProfile: (profileId: text) ->
   (ValidationReport) query;
  validateDemoPacs009: () -> (ValidationReport) query;
  validateDemoPain001: () -> (ValidationReport) query;
  validateDemoPain001WithProfile: (profileId: text) ->
   (ValidationReport) query;
  validateDirectDebitWithProfile: (profileId: text, doc: DirectDebitMessage,
   rawXml: opt blob) -> (ValidationReport) query;
  validateDirectDebitXml: (xml: blob) -> (ValidationReport) query;
  validateDirectDebitXmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateInvestigation: (doc: InvestigationMessage) ->
   (ValidationReport) query;
  validateInvestigationWithProfile: (profileId: text, doc:
   InvestigationMessage) -> (ValidationReport) query;
  validateInvestigationXml: (xml: blob) -> (ValidationReport) query;
  validateInvestigationXmlWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  validateIsoBreadth: (xml: blob) -> (ValidationReport) query;
  validateIsoBreadthWithProfile: (profileId: text, xml: blob) ->
   (ValidationReport) query;
  /// An official-shape message (any of the 43 schema profiles, with or without its AppHdr) under the active
  /// guideline: the schema, the business reading, and the rule set the default profile is bound to.
  validateIsoDocument: (xml: blob) -> (IsoDocumentReport) query;
  validateIsoDocumentWithProfile: (profileId: text, xml: blob) ->
   (IsoDocumentReport) query;
  /// The same reading under a named rule set, whatever the profile binding.
  validateIsoDocumentWithRuleSet: (ruleSetId: text, xml: blob) ->
   (IsoDocumentReport) query;
  validatePacs008: (doc: Pacs008CreditTransfer, rawXml: opt blob) ->
   (ValidationReport) query;
  validatePacs008WithProfile: (profileId: text, doc: Pacs008CreditTransfer,
   rawXml: opt blob) -> (ValidationReport) query;
