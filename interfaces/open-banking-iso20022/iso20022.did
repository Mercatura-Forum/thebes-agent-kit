   (SettlementOffsetResult);
  retryOutboundBatch: (batchId: nat) -> (opt OutboundBatch);
  returnPayment: (paymentId: nat, reason: text) -> (HubPayment);
  /// The message read, written and read again: `#ok` is the written document when the two readings are
  /// equal — the property the integration kit's breadth runner asserts on every fixture.
  roundTripIsoBreadth: (xml: blob, options: BreadthEmitOptions) ->
   (Result) query;
  runEndOfDay: (currency: text) -> (EndOfDayStatementRun);
  screenCoverPayment: (doc: CoverPayment) -> (ComplianceReport) query;
