/// ISO 20022 Egypt-focused financial hub example for Thebes.
/// 
/// The canister owns admin state, an active usage-guideline configuration,
/// payment lifecycle state, duplicate indexes, and append-only audit evidence.
/// ISO-specific validation rules live in ISO20022.mo so bank/rail-specific
/// implementation guidelines can be loaded as data.
service : {
  ackOutboundDelivery: (ack: DeliveryAck) -> (opt OutboundBatch);
  acknowledgePacs002: (paymentId: nat, transactionStatus: text, reason:
   opt text) -> (HubPayment);
  addAdmin: (who: principal) -> (bool);
  administrativeToXml: (doc: AdministrativeMessage) -> (text) query;
  auditCount: () -> (nat) query;
  auditDemoPacs008: () -> (AuditRecord);
  auditPacs008: (doc: Pacs008CreditTransfer, rawXml: opt blob) ->
   (AuditRecord);
  auditPacs008Xml: (xml: blob) -> (AuditXmlResult);
  auditProof: (id: nat) -> (opt AuditProof) query;
  auditTip: () -> (AuditTip) query;
  bindGuidelineRuleSet: (profileId: text, ruleSetId: text) -> (bool);
  camt053Statement: (offset: nat, limit: nat) -> (Page_13) query;
  camt053StatementByAccount: (accountId: text, fromBookedAtInclusive: 
   int, toBookedAtExclusive: int, offset: nat, limit: nat) -> (Page_13) query;
  camt053StatementByAccountStable: (accountId: text, fromBookedAtInclusive:
   int, toBookedAtExclusive: int, offset: nat, limit: nat) -> (Page_13) query;
  camt053Xml: (offset: nat, limit: nat) -> (text) query;
  camt053XmlByAccount: (accountId: text, fromBookedAtInclusive: int,
   toBookedAtExclusive: int, offset: nat, limit: nat) -> (text) query;
  camt054Notification: (paymentId: nat) -> (opt StatementEntry) query;
  camt054Xml: (paymentId: nat) -> (opt text) query;
  capabilities: () -> (vec Capability) query;
  certifiedAuditDisclosure: () -> (CertifiedAuditDisclosure) query;
  certifiedAuditDisclosureJson: () -> (text) query;
  certifiedDisclosureCertificate: () ->
   (CertifiedDisclosureCertificate) query;
  certifiedDisclosureCertificateJson: () -> (text) query;
  certifiedParticipantBalance: (bicfi: text) ->
   (opt CertifiedBalanceDisclosure) query;
  checkSettlementLiquidity: (paymentId: nat) ->
   (SettlementLiquidityCheck) query;
  checkpointMap: () -> (vec CheckpointMapEntry) query;
  checkpointSecondaryIndexes: () -> (SecondaryIndexHealth);
  claimOwner: () -> (bool);
  clearConnectorGuidelineProfile: (connectorId: text) -> (bool);
  complianceReportToXml: (report: ComplianceReport) -> (text) query;
  configureOperatingDay: (config: OperatingDayConfig) -> (OperatingDayStatus);
  connectorEnvelopeSigningHash: (env: TransportEnvelope) -> (blob) query;
  correlateAdministrativeWorkflow: (doc: AdministrativeMessage) ->
   (WorkflowCorrelationResult);
  correlateDemoDirectDebitReturnWorkflow: () -> (WorkflowState);
  correlateDemoRequestToPayWorkflow: () -> (WorkflowState);
  correlateDirectDebitWorkflow: (doc: DirectDebitMessage, rawXml:
   opt blob) -> (WorkflowCorrelationResult);
  correlateInvestigationWorkflow: (doc: InvestigationMessage) ->
   (WorkflowCorrelationResult);
  correlateRequestToPayWorkflow: (doc: RequestToPayMessage) ->
   (WorkflowCorrelationResult);
  coverPaymentToXml: (doc: CoverPayment) -> (text) query;
  decodeAdministrativeXml: (xml: blob) -> (AdministrativeXmlDecode) query;
  decodeCamt053Xml: (xml: blob) -> (StatementXmlDecode) query;
  decodeCamt054Xml: (xml: blob) -> (StatementXmlDecode) query;
  decodeCoverPaymentXml: (xml: blob) -> (CoverPaymentXmlDecode) query;
  decodeCsvPayments: (csv: blob) -> (LegacyPaymentFileDecode) query;
  decodeDirectDebitXml: (xml: blob) -> (DirectDebitXmlDecode) query;
  decodeFixedWidthPayments: (payload: blob) ->
   (LegacyPaymentFileDecode) query;
  decodeInvestigationXml: (xml: blob) -> (InvestigationXmlDecode) query;
  decodeIsoBreadth: (xml: blob) -> (BreadthDecode) query;
  decodeIsoBreadthWithProfile: (profileId: text, xml: blob) ->
   (BreadthDecode) query;
  /// A FIN message read into its record under the active guideline; `hint` names the type when block 2 is absent.
  decodeMt: (payload: blob, hint: opt text) -> (MtDecode) query;
  decodeMt103: (mt: blob) -> (Mt103Decode) query;
  decodeMt940: (mt: blob) -> (MtStatementDecode) query;
  decodeMt942: (mt: blob) -> (MtStatementDecode) query;
  decodeMtWithProfile: (profileId: text, payload: blob, hint: opt text) ->
   (MtDecode) query;
  decodePacs008Xml: (xml: blob) -> (Pacs008XmlDecode) query;
  decodePacs009Xml: (xml: blob) -> (Pacs009XmlDecode) query;
  decodePain001Xml: (xml: blob) -> (Pain001XmlDecode) query;
  decodeRequestToPayXml: (xml: blob) -> (RequestToPayXmlDecode) query;
  decodeStatusReportXml: (xml: blob) -> (StatusReportXmlDecode) query;
  demoAdmi002Reject: () -> (AdministrativeMessage) query;
  demoAdmi002RejectXml: () -> (text) query;
  demoAdmi004ConnectionCheck: () -> (AdministrativeMessage) query;
  demoAdmi004ConnectionCheckXml: () -> (text) query;
  demoAdmi007Ack: () -> (AdministrativeMessage) query;
  demoAdmi007AckXml: () -> (text) query;
  demoAdmi011ConnectionAck: () -> (AdministrativeMessage) query;
  demoAdmi011ConnectionAckXml: () -> (text) query;
  demoCamt029: () -> (InvestigationMessage) query;
  demoCamt055: () -> (RequestToPayMessage) query;
  demoCamt055Xml: () -> (text) query;
  demoCamt056: () -> (InvestigationMessage) query;
  demoCamt056Xml: () -> (text) query;
  demoCamt110: () -> (InvestigationMessage) query;
  demoCamt110Xml: () -> (text) query;
  demoCamt111: () -> (InvestigationMessage) query;
  demoCamt111Xml: () -> (text) query;
  demoComplianceReportXml: () -> (text) query;
  demoCoverPayment: () -> (CoverPayment) query;
  demoCoverPaymentXml: () -> (text) query;
  demoCrossBorderPacs008: () -> (Pacs008CreditTransfer) query;
  demoCrossBorderPain001: () -> (CustomerCreditTransferInitiation) query;
  demoPacs003: () -> (DirectDebitMessage) query;
  demoPacs003Xml: () -> (text) query;
  demoPacs008: () -> (Pacs008CreditTransfer) query;
  demoPacs008Xml: () -> (text) query;
  demoPacs009Core: () -> (Pacs009FinancialInstitutionCreditTransfer) query;
  demoPacs009Xml: () -> (text) query;
  demoPacs028: () -> (InvestigationMessage) query;
  demoPain001: () -> (CustomerCreditTransferInitiation) query;
  demoPain001Xml: () -> (text) query;
  demoPain008: () -> (DirectDebitMessage) query;
  demoPain008Xml: () -> (text) query;
  demoPain013: () -> (RequestToPayMessage) query;
  demoPain013Xml: () -> (text) query;
  demoPain014Accepted: () -> (RequestToPayMessage) query;
  demoPain014AcceptedXml: () -> (text) query;
  directDebitToXml: (doc: DirectDebitMessage) -> (text) query;
  dispatchOrQueuePacs008: (paymentId: nat, priority: nat, bypassFifo:
   bool) -> (SettlementDispatchResult);
  dispatchPacs008: (paymentId: nat) -> (Pacs008CreditTransfer);
  duplicateFilterInfo: () -> (DuplicateFilterInfo) query;
  duplicateSignalFor: (messageId: text, uetr: text) ->
   (DuplicateSignal) query;
  /// A record written in its family's official shape, or the fields the schema needs and the record lacks.
  encodeIsoBreadth: (message: BreadthMessage, options: BreadthEmitOptions) ->
   (Result) query;
  /// A record written as the named FIN type; `parties` names the envelope's institutions where the record does not.
  encodeMt: (message: MtMessage, mtType: text, parties: MtParty) ->
   (Result) query;
  failOutboundDelivery: (batchId: nat, detail: text) -> (opt OutboundBatch);
  getAdmins: () -> (vec principal) query;
  getAudit: (id: nat) -> (opt AuditRecord) query;
  getComplianceProfile: () -> (ComplianceProfile) query;
  getConnector: (id: text) -> (opt ConnectorConfig) query;
  getConnectorGuidelineProfile: (connectorId: text) ->
   (opt ConnectorGuidelineProfile) query;
  getCrossBorderEducationGuideline: () -> (UsageGuideline) query;
  getDefaultGuidelineProfile: () -> (GuidelineProfileSummary) query;
  getDefaultGuidelineProfileId: () -> (text) query;
  getEndOfDayRun: (id: nat) -> (opt EndOfDayStatementRun) query;
  getGuideline: () -> (UsageGuideline) query;
  getGuidelineProfile: (profileId: text) -> (opt GuidelineProfile) query;
  getMemphisAudience: () -> (text) query;
  getMemphisGateConfig: () ->
   (record {
      memphis: principal;
      origin: text;
      version: nat64;
    }) query;
  getOperatingDay: (currency: text) -> (opt OperatingDayConfig) query;
  getOutboundBatch: (id: nat) -> (opt OutboundBatch) query;
  getOwner: () -> (opt principal) query;
  getParticipantDirectoryEntry: (bicfi: text) ->
   (opt ParticipantDirectoryEntry) query;
  getPayment: (id: nat) -> (opt HubPayment) query;
  getPaymentByUetr: (uetr: text) -> (opt HubPayment) query;
  getPaymentComplianceReport: (paymentId: nat) ->
   (opt ComplianceScreeningRecord) query;
  getSettlementDebitLimit: (bicfi: text) -> (SettlementLiquidityLimit) query;
  getSettlementLedger: () -> (SettlementLedgerConfig) query;
  getSettlementParticipantAccount: (bicfi: text) -> (opt IcrcAccount) query;
  getSettlementQueueEntry: (paymentId: nat) ->
   (opt SettlementQueueEntry) query;
  getTransportRecord: (id: nat) -> (opt TransportRecord) query;
  getWorkflowByMessageId: (messageId: text) -> (opt WorkflowState) query;
  getWorkflowByUetr: (uetr: text) -> (opt WorkflowState) query;
  getWorkflowState: (id: text) -> (opt WorkflowState) query;
  /// The rule set a guideline profile is bound to (CBPRPLUS-EDU is bound to CBPRPLUS unless rebound).
  guidelineRuleSet: (profileId: text) -> (opt text) query;
  integrationProfilePacks: () -> (vec IntegrationProfilePack) query;
  investigationToXml: (doc: InvestigationMessage) -> (text) query;
  isPaused: () -> (bool) query;
  /// The families the schema-profile codec reads and writes, by message definition identifier.
  isoBreadthFamilies: () -> (vec text) query;
  isoRuleSetRules: (ruleSetId: text) -> (vec RuleView) query;
  isoRuleSets: () -> (vec RuleSetSummary) query;
  /// Every official schema the canister carries as a generated profile: the compact codec's families,
  /// the business application header and the schema-profile codec's families (43).
  isoSchemaProfiles: () -> (vec SchemaProfileSummary) query;
  leaseOutboundBatches: (connectorId: text, limit: nat, leaseMillis: 
   nat) -> (vec OutboundBatch);
  listAuditViews: (offset: nat, limit: nat) -> (Page_12) query;
  listAudits: (offset: nat, limit: nat) -> (Page_11) query;
  listCertifiedParticipantBalances: (offset: nat, limit: nat) ->
   (Page_10) query;
  listCertifiedParticipantBalancesJson: (offset: nat, limit: nat) ->
