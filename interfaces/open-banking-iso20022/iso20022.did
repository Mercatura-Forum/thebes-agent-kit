  setConnectorActive: (id: text, active: bool) -> (bool);
  setConnectorGuidelineProfile: (connectorId: text, profileId: text) ->
   (ConnectorGuidelineProfile);
  setConnectorSignaturePolicy: (id: text, policy: SignaturePolicy) ->
   (ConnectorConfig);
  setDefaultGuidelineProfile: (profileId: text) -> (GuidelineProfileSummary);
  setGuideline: (next: UsageGuideline) -> (bool);
  /// Set the web origin whose sessions this contract accepts.
  /// 
  /// Safe to change — unlike the namespace on the gate, it touches no identity:
  /// it only says where a token must have been minted. Change it when the
  /// submitting frontend moves to a new domain. It must be a bare origin
  /// (scheme + host + optional port) because Memphis compares it byte-exactly.
  setMemphisAudience: (audience: text) -> (bool);
  setMemphisGate: (memphis: principal, origin: text, version: nat64) ->
   (bool);
  setMemphisGateByCid: (cid: nat64, origin: text, version: nat64) -> (bool);
  setOperatingDayPhase: (currency: text, phase: text) -> (OperatingDayStatus);
  setPaused: (value: bool) -> (bool);
  setSettlementDebitLimit: (bicfi: text, maxDebitMinorUnits: opt nat) ->
   (SettlementLiquidityLimit);
  setSettlementLedger: (config: SettlementLedgerConfig) ->
   (SettlementLedgerConfig);
  setSettlementParticipantAccount: (bicfi: text, account: IcrcAccount) ->
   (bool);
  settleQueuedPacs008: (paymentId: nat) -> (HubPayment);
  settlementLiquidityPosition: (bicfi: text) ->
   (SettlementLiquidityPosition) query;
  statusReportToXml: (doc: StatusReport) -> (text) query;
  submitDemoPain001: () -> (HubPayment);
  submitPain001: (instruction: CustomerCreditTransferInitiation, rawXml:
   opt blob) -> (HubPayment);
  submitPain001WithProfile: (profileId: text, instruction:
   CustomerCreditTransferInitiation, rawXml: opt blob) -> (HubPayment);
  submitPain001Xml: (xml: blob) -> (SubmitXmlResult);
  submitPain001XmlWithProfile: (profileId: text, xml: blob) ->
   (SubmitXmlResult);
  submitTransportEnvelope: (env: TransportEnvelope) ->
   (TransportSubmitResult);
  submitTransportEnvelopeWithMemphis: (env: TransportEnvelope, token:
   blob) -> (MemphisTransportSubmitResult);
  supportedStandards: () -> (vec SupportedStandard) query;
  transferOwner: (newOwner: principal) -> (bool);
  transportCount: () -> (nat) query;
  upsertParticipantDirectoryEntry: (input: ParticipantDirectoryInput) ->
   (ParticipantDirectoryEntry);
  useExternalSignatureAuth: (id: text, scheme: text, publicKeyHash: opt blob,
   verifier: principal) -> (ConnectorConfig);
  useMemphisSessionAuth: (id: text) -> (ConnectorConfig);
  useThebesCallerAuth: (id: text) -> (ConnectorConfig);
  validateAdministrativeWithProfile: (profileId: text, doc:
   AdministrativeMessage) -> (ValidationReport) query;
  validateAdministrativeXml: (xml: blob) -> (ValidationReport) query;
  validateAdministrativeXmlWithProfile: (profileId: text, xml: blob) ->
