  listSettlementParticipantAccounts: () ->
   (vec SettlementParticipantAccount) query;
  listSettlementQueue: (offset: nat, limit: nat) -> (Page_2) query;
  listSettlementQueueByStatus: (status: text, offset: nat, limit: nat) ->
   (Page_2) query;
  listTransportRecords: (offset: nat, limit: nat) -> (Page_1) query;
  listWorkflowStates: (offset: nat, limit: nat) -> (Page) query;
  /// The field-to-element mapping tables the bridge implements — the same data the fixture set carries.
  mtBridgeMappings: () -> (vec MtMapping) query;
  /// The bridge's message types and the ISO family each reads into.
  mtBridgeTypes: () -> (vec record {
                              text;
                              text;
                            }) query;
  openOperatingDay: (currency: text, businessDate: text, cutoffAt: int,
